# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pwusage"
# Optional SSL CA certificate pinning. Provide either the raw PEM content or a file path.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL_CA_FILE="certs/supabase-ca.crt"


# Tesla Fleet API Configuration
# See: https://developer.tesla.com/docs/fleet-api
PUBLIC_TESLA_OAUTH_CLIENT_ID="your-tesla-client-id"
TESLA_OAUTH_SECRET="your-tesla-client-secret"

# Web App Configuration
PUBLIC_WEBAPP_BASE_URL="http://localhost:5173"

# Trmnl Integration
# See: https://usetrmnl.com/plugins/my/new
TRMNL_CLIENT_ID="your-trmnl-client-id"
TRMNL_CLIENT_SECRET="your-trmnl-client-secret"

# Import Configuration (Optional)
# IMPORT_TIMEOUT_MS=600000
# IMPORT_GRANULARITY=day

# Header live sparkline y-axis clamp window (hours)
# SPARKLINE_SCALE_WINDOW_HOURS=12

# Battery hold Live Activity pushes (APNs token auth). Leave unset to keep the
# delivery cron a no-op. See docs/battery-hold-live-activity-delivery.md.
# APNS_KEY_ID="ABC123DEFG"
# APNS_TEAM_ID="6HQGHHRK87"
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_BUNDLE_ID="fm.rodeo.pwusage"

# --- Tesla token encryption at rest (required wherever Tesla tokens are written) ---
# Encryption keys: comma-separated "<keyId>:<base64 32-byte key>". The FIRST entry encrypts
# new writes; older entries stay so existing rows still decrypt (key rotation = prepend a new one).
# Generate a key:  openssl rand -base64 32
# Example value:   TOKEN_ENCRYPTION_KEYS=k1:<output of the command above>
TOKEN_ENCRYPTION_KEYS=

# Fingerprint key: a separate 32-byte base64 key (never reuse an encryption key). It keys the
# HMAC stored in User.refresh_token_fp, which the single-use refresh compare-and-swap compares.
# Generate:  openssl rand -base64 32
# Changing it invalidates every stored fingerprint, so don't rotate it without a backfill.
TOKEN_FINGERPRINT_KEY=