  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch import cli",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/import/main.go",
      "args": ["2252268092126997"],
      "env": {
        
      }
    },

    {
      "name": "Launch pocketbase server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/pocketbase/",
      "env": {
      },
      "args": [
        "serve",
        "--http=0.0.0.0:8090"
      ],
    },
    {
      "name": "Attach to TUI",
      "type": "go",
      "debugAdapter": "dlv-dap",
      "request": "attach",
      "mode": "remote",
      "remotePath": "${workspaceFolder}/cmd/tui",
      "port": 2345,
      "host": "127.0.0.1",
      "preLaunchTask": "Run headless dlv" // Here !
    },
  ]
}
